
pipeline {
    agent any

    environment {
        KUBECONFIG = 'C:\\Users\\orsut\\.kube\\config'
        PATH = "C:\\Users\\orsut\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
    }

    stages {
        stage('Check Kubernetes') {
            steps {
                bat 'kubectl get nodes'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t myapp:latest -f AGILE/src/dockerfile AGILE/src'
                bat 'minikube image load myapp:latest'
            }
        }

        stage('Deploy Application') {
            steps {
                bat 'kubectl apply -f AGILE/k8s/deployment.yaml'
                bat 'kubectl apply -f AGILE/k8s/service.yaml'
                bat 'kubectl rollout status deployment/myapp --timeout=180s'
            }
        }

        stage('Verify Deployment') {
            steps {
                bat 'kubectl get deployments'
                bat 'kubectl get pods'
                bat 'kubectl get services'
            }
        }
    }
}

